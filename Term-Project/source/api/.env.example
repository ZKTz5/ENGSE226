NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Leave blank for local development. Set a strong random value in production.
JWT_SECRET=

# Explicitly opt in to deleting vehicle-request demo data via the admin API.
# Keep false in production unless an operator intentionally enables the action.
ENABLE_ADMIN_DATA_RESET=false

# ⭐⭐ Challenge Turso — เว้นว่างไว้ = ใช้ campus.db ในเครื่อง
# ค่าจริงใส่ใน .env (ห้าม commit) หรือใน Environment ของ Render
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
